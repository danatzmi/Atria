# Copy this file to .env.local and fill in values from `supabase status`
# (after running `npx supabase start`) for local development, or from your
# Supabase project settings for a hosted project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or reference it from
# client-side code. Used only for privileged, trusted server operations
# (e.g. test fixtures) — normal app requests must use the user's session.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Lemon Squeezy). Only the server reads these; the browser only
# ever receives a checkout URL. Swapping providers means adding a new
# adapter under src/lib/payments/ and changing one line in its index.ts.
LEMON_SQUEEZY_API_KEY=
# From the Lemon Squeezy dashboard: Settings -> Stores. Required by the
# checkout API.
LEMON_SQUEEZY_STORE_ID=
NEXT_PUBLIC_LS_BASIC_VARIANT_ID=
NEXT_PUBLIC_LS_PRO_VARIANT_ID=
# From Lemon Squeezy: Settings -> Webhooks -> your endpoint's signing secret.
LEMON_SQUEEZY_WEBHOOK_SECRET=
